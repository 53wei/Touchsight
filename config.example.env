# Optional OpenAI-compatible multimodal model.
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-vl-max
AI_TIMEOUT_SECONDS=90
AI_SUPPORTS_VISION=true

# Optional separate vision model. This lets a local text model and remote VLM coexist.
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=openrouter/free
VISION_TIMEOUT_SECONDS=180
VISION_SUPPORTS_VISION=true

# Optional future ESP32/RDK bridge. The endpoint should accept frame JSON by POST.
# Leave empty while the hardware protocol is not frozen; frames are exported to output/hardware/.
TOUCHSIGHT_HARDWARE_URL=
